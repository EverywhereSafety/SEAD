+++ b/tests/unit/test_action_execution_server_session_recovery.py
@@ -0,0 +1,120 @@
+import asyncio
+
+from openhands.events.action import CmdRunAction
+from openhands.events.observation import ErrorObservation
+from openhands.runtime.action_execution_server import ActionExecutor
+
+
+def test_dead_persistent_session_is_rebuilt_without_retrying_action():
+    class DeadSession:
+        cwd = '/workspace/current'
+        closed = False
+
+        def is_alive(self):
+            return False
+
+        def close(self):
+            self.closed = True
+
+        def execute(self, action):  # pragma: no cover - regression tripwire
+            raise AssertionError('interrupted action was retried')
+
+    class ReplacementSession:
+        def is_alive(self):
+            return True
+
+    dead = DeadSession()
+    replacement = ReplacementSession()
+    executor = ActionExecutor.__new__(ActionExecutor)
+    executor.bash_session = dead
+    executor._initial_cwd = '/workspace'
+    created_in = []
+
+    def create(cwd=None):
+        created_in.append(cwd)
+        return replacement
+
+    executor._create_bash_session = create
+
+    observation = asyncio.run(
+        executor.run(CmdRunAction(command='touch /tmp/must-not-run-twice'))
+    )
+
+    assert isinstance(observation, ErrorObservation)
+    assert 'was not retried' in observation.content
+    assert dead.closed is True
+    assert executor.bash_session is replacement
+    assert executor._bash_session_rebuild_count == 1
+    assert created_in == ['/workspace/current']
+
+
+def test_action_that_kills_session_is_not_implicitly_retried():
+    class DyingSession:
+        cwd = '/workspace/current'
+        closed = False
+        liveness_checks = 0
+        executions = 0
+
+        def is_alive(self):
+            self.liveness_checks += 1
+            return self.liveness_checks == 1
+
+        def close(self):
+            self.closed = True
+
+        def execute(self, action):
+            self.executions += 1
+            raise RuntimeError('tmux pane disappeared')
+
+    class ReplacementSession:
+        def is_alive(self):
+            return True
+
+    dying = DyingSession()
+    replacement = ReplacementSession()
+    executor = ActionExecutor.__new__(ActionExecutor)
+    executor.bash_session = dying
+    executor._initial_cwd = '/workspace'
+    executor._create_bash_session = lambda cwd=None: replacement
+
+    observation = asyncio.run(executor.run(CmdRunAction(command='C-d')))
+
+    assert isinstance(observation, ErrorObservation)
+    assert 'was not retried' in observation.content
+    assert dying.executions == 1
+    assert dying.closed is True
+    assert executor.bash_session is replacement
+
+
+def test_action_that_returns_as_session_exits_is_reported_as_rebuilt():
+    class ExitingSession:
+        cwd = '/workspace/current'
+        closed = False
+        liveness_checks = 0
+        executions = 0
+
+        def is_alive(self):
+            self.liveness_checks += 1
+            return self.liveness_checks == 1
+
+        def close(self):
+            self.closed = True
+
+        def execute(self, action):
+            self.executions += 1
+            return ErrorObservation('stale observation from exited shell')
+
+    exiting = ExitingSession()
+    replacement = object()
+    executor = ActionExecutor.__new__(ActionExecutor)
+    executor.bash_session = exiting
+    executor._initial_cwd = '/workspace'
+    executor._create_bash_session = lambda cwd=None: replacement
+
+    observation = asyncio.run(executor.run(CmdRunAction(command='exit')))
+
+    assert isinstance(observation, ErrorObservation)
+    assert 'was not retried' in observation.content
+    assert exiting.executions == 1
+    assert exiting.closed is True
+    assert executor.bash_session is replacement
